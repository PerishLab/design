{
	"compilerOptions": {
		"target": "ES2022",
		"lib": ["ES2022", "DOM"],
		"module": "ESNext",
		"moduleResolution": "bundler",
		"allowImportingTsExtensions": true,
		"strict": true,
		"noEmit": true,
		"isolatedModules": true,
		"skipLibCheck": true,
		"paths": {
			"@perishlab/bone": ["../../packages/bone/src/lib.ts"],
			"@perishlab/design": ["../../packages/design/src/lib.ts"],
			"@perishlab/design/vite": ["../../packages/design/src/vite/lib.ts"]
		},
		"types": ["vite/client", "node"]
	},
	"include": ["src", "tests", "vite.config.ts", "vitest.config.ts"]
}
