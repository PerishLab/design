{
	"$schema": "https://biomejs.dev/schemas/2.5.14/schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"files": {
		"includes": ["**", "!**/*.svelte", "!**/.svelte-kit", "!.runseal"]
	},
	"formatter": {
		"enabled": true
	},
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended"
		}
	},
	"overrides": [
		{
			"includes": ["packages/bone/**"],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"paths": {
									"@perishlab/token": "The bone names no atom; it never reaches the token substrate."
								},
								"patterns": [
									{
										"group": ["@perishlab/token/**"],
										"message": "The bone names no atom; it never reaches the token substrate."
									}
								]
							}
						}
					}
				}
			}
		}
	]
}
