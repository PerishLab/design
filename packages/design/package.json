{
	"name": "@perishlab/design",
	"version": "0.0.0",
	"license": "MIT",
	"type": "module",
	"files": [
		"dist"
	],
	"svelte": "./dist/lib.js",
	"exports": {
		".": {
			"types": "./dist/lib.d.ts",
			"svelte": "./dist/lib.js",
			"default": "./dist/lib.js"
		},
		"./vite": {
			"types": "./dist/vite/lib.d.ts",
			"default": "./dist/vite/lib.js"
		}
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "svelte-package -i src -o dist",
		"prepack": "pnpm build",
		"typecheck": "svelte-check --tsconfig ./tsconfig.json",
		"test": "vitest run"
	},
	"peerDependencies": {
		"sass": ">=1.101",
		"svelte": ">=5.56"
	},
	"devDependencies": {
		"@sveltejs/package": "catalog:",
		"@sveltejs/vite-plugin-svelte": "catalog:",
		"@types/node": "catalog:",
		"sass": "catalog:",
		"svelte": "catalog:",
		"svelte-check": "catalog:",
		"typescript": "catalog:",
		"vite": "catalog:",
		"vitest": "catalog:"
	},
	"dependencies": {
		"@perishlab/bone": "workspace:*",
		"@perishlab/crest": "^0.1.0",
		"@perishlab/sidecar": "0.9.0",
		"@perishlab/sign": "workspace:*",
		"@perishlab/token": "workspace:*"
	}
}
