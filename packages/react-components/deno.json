{
	"name": "@perish/react-components",
	"version": "0.1.0",
	"license": "MIT",
	"exports": {
		".": "./src/lib.ts"
	},
	"imports": {
		"react": "npm:react@^19.2.7",
		"react/jsx-runtime": "npm:react@^19.2.7/jsx-runtime",
		"@types/react": "npm:@types/react@^19.2.17"
	},
	"compilerOptions": {
		"strict": true,
		"jsx": "react-jsx",
		"jsxImportSource": "react",
		"lib": ["esnext", "dom"],
		"types": ["npm:@types/react@^19.2.17"]
	},
	"publish": {
		"exclude": [
			"node_modules",
			"package.json",
			"tsconfig.json",
			"vitest.config.ts",
			"tests"
		]
	}
}
