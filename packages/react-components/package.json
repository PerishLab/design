{
	"name": "@perish/react-components",
	"version": "0.1.0",
	"license": "MIT",
	"type": "module",
	"files": [
		"dist"
	],
	"exports": {
		".": {
			"types": "./dist/lib.d.ts",
			"default": "./dist/lib.js"
		}
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "tsc -p tsconfig.build.json && node -e \"require('node:fs').cpSync('src','dist',{recursive:true,filter:(p)=>!/\\.tsx?$/.test(p)})\"",
		"test": "vitest run"
	},
	"peerDependencies": {
		"react": ">=19"
	},
	"devDependencies": {
		"@types/react": "catalog:",
		"@types/react-dom": "catalog:",
		"react-dom": "catalog:",
		"sass": "catalog:",
		"typescript": "catalog:",
		"vite": "catalog:",
		"vitest": "catalog:"
	}
}
