{
	"name": "@perish/react-components",
	"version": "0.1.1",
	"license": "MIT",
	"type": "module",
	"files": [
		"dist"
	],
	"exports": {
		".": {
			"types": "./dist/lib.d.ts",
			"default": "./dist/lib.js"
		},
		"./client": {
			"types": "./dist/client.d.ts"
		}
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json && node -e \"const fs=require('node:fs');fs.cpSync('src','dist',{recursive:true,filter:(p)=>!/\\.tsx?$/.test(p)});fs.copyFileSync('src/client.d.ts','dist/client.d.ts')\"",
		"test": "vitest run"
	},
	"dependencies": {
		"react-router": "catalog:"
	},
	"peerDependencies": {
		"react": ">=19"
	},
	"devDependencies": {
		"@types/react": "catalog:",
		"@types/react-dom": "catalog:",
		"react-dom": "catalog:",
		"sass": "catalog:",
		"typescript": "catalog:",
		"vite": "catalog:",
		"vitest": "catalog:"
	}
}
